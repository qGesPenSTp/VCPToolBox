# Copy to config.env for local use. Never commit config.env or browser cookies.

# Set true only while troubleshooting.
DebugMode=false

# Optional request limits (milliseconds).
# SYNCHROVISION_TIMEOUT_MS=15000
# SYNCHROVISION_REQUEST_TIMEOUT_MS=12000
# SYNCHROVISION_HISTORY_ENRICH=2

# Optional Bilibili cookie file. Prefer a local Netscape export over inline cookies.
# BILIBILI_COOKIE_FILE=C:\path\to\www.bilibili.com_cookies.txt
